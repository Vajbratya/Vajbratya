        <MiniModule frame={frame} index={2} label="CRIT" value="Achado crítico." detail="Confirmação e comunicação com rastro." />
        <MiniModule frame={frame} index={3} label="RIS / PACS" value="Volta para o fluxo." detail="Sem copiar e colar o dia inteiro." />
      </div>
      <div
        style={{
          position: 'absolute',
          left: 66,
          right: 66,
          bottom: 126,
          height: 158,
          border: `1.5px solid ${INK}`,
          display: 'flex',
          alignItems: 'center',
          padding: '0 34px',
          gap: 28,
          opacity: interpolate(frame, [98, 116], [0, 1], clamp),
        }}
      >
        <div
          style={{
            width: 72,
            height: 72,
            borderRadius: 999,
            border: `2px solid ${INK}`,
            display: 'grid',
            placeItems: 'center',
            scale: check,
            fontFamily: instrumentSans,
            fontWeight: 700,
            fontSize: 36,
          }}
        >
          ✓
        </div>
        <div>
          <div style={{fontFamily: ibmPlexMono, fontSize: 18, letterSpacing: '0.11em', color: MUTED}}>AUTORIA MÉDICA</div>
          <div style={{fontFamily: instrumentSans, fontSize: 40, fontWeight: 600, letterSpacing: '-0.035em', marginTop: 8}}>Você revisa. Você assina.</div>
        </div>
      </div>
      <FilmTexture />
    </AbsoluteFill>
  );
};

