    ['GUIDE', 'Classificação no ponto certo'],
    ['CRIT', 'Achado crítico com confirmação'],
    ['REVISÃO', 'Autoria médica preservada'],
    ['RIS / PACS', 'O laudo volta para o fluxo'],
  ] as const;
  const titleOpacity = interpolate(frame, [28, 48, 142, 163], [0, 1, 1, 0], clamp);
  return (
    <AbsoluteFill style={{backgroundColor: INK, overflow: 'hidden'}}>
      <FrameLabel label="04 / CAMADA PÓS-IMAGEM" right="UM EXAME · UM FLUXO" invert />
      <div
        style={{
          position: 'absolute',
          left: 66,
          right: 66,
          top: 190,
          zIndex: 4,
          color: CREAM,
          opacity: titleOpacity,
        }}
      >
        <div style={{fontFamily: instrumentSans, fontSize: 104, fontWeight: 600, letterSpacing: '-0.06em', lineHeight: 0.94}}>
          ENTRE O DITADO<br />E A ASSINATURA,
        </div>
        <div style={{fontFamily: instrumentSans, fontSize: 58, fontWeight: 500, letterSpacing: '-0.045em', lineHeight: 1, marginTop: 24, opacity: 0.72}}>
          existe uma camada inteira.
        </div>
      </div>
      {planes.map(([label, detail], index) => (
        <DepthPlane key={label} index={index} frame={frame} label={label} detail={detail} />
      ))}
      <div
        style={{
          position: 'absolute',
          left: 66,
          right: 66,
          bottom: 120,
          color: CREAM,
          opacity: interpolate(frame, [130, 158], [0, 1], clamp),
        }}
      >
        <div style={{fontFamily: ibmPlexMono, fontSize: 20, letterSpacing: '0.1em', opacity: 0.6}}>LAUDOS.AI</div>
        <div style={{fontFamily: instrumentSans, fontSize: 70, fontWeight: 600, letterSpacing: '-0.055em', lineHeight: 0.97, marginTop: 16}}>
          É A CAMADA<br />QUE JUNTA TUDO.
        </div>
      </div>
      <FilmTexture invert />
    </AbsoluteFill>
  );
};

const MiniModule: React.FC<{label: string; value: string; detail: string; index: number; frame: number}> = ({label, value, detail, index, frame}) => {
  const local = frame - 8 - index * 11;
  const p = spring({fps: 30, frame: local, config: {damping: 17, stiffness: 145}});
  return (
    <div
      style={{
        borderTop: `2px solid ${INK}`,
        paddingTop: 18,
        opacity: interpolate(local, [0, 10], [0, 1], clamp),
        translate: `0px ${interpolate(p, [0, 1], [34, 0], clamp)}px`,
      }}
    >
      <div style={{fontFamily: ibmPlexMono, fontWeight: 600, fontSize: 18, letterSpacing: '0.1em', color: MUTED}}>{label}</div>
      <div style={{fontFamily: instrumentSans, fontWeight: 600, fontSize: 54, letterSpacing: '-0.05em', marginTop: 12}}>{value}</div>
      <div style={{fontFamily: instrumentSans, fontSize: 27, letterSpacing: '-0.02em', marginTop: 8, lineHeight: 1.15, color: MUTED}}>{detail}</div>
    </div>
  );
};

const SceneProof: React.FC = () => {
  const frame = useCurrentFrame();
  const check = spring({fps: 30, frame: frame - 110, config: {damping: 14, stiffness: 180}});
  return (
    <AbsoluteFill style={{backgroundColor: CREAM, color: INK, overflow: 'hidden'}}>
      <FrameLabel label="05 / O QUE MUDA" right="SEM TROCAR O RACIOCÍNIO" />
      <div style={{position: 'absolute', left: 66, right: 66, top: 210}}>
        <div style={{fontFamily: instrumentSans, fontWeight: 600, fontSize: 94, lineHeight: 0.95, letterSpacing: '-0.06em'}}>
          VOCÊ CONTINUA<br />FAZENDO RADIOLOGIA.
        </div>
        <div style={{fontFamily: instrumentSans, fontWeight: 500, fontSize: 48, lineHeight: 1.05, letterSpacing: '-0.04em', color: MUTED, marginTop: 26}}>
          Do ditado ao laudo assinado, o fluxo deixa de ser trabalho manual.
        </div>
      </div>
      <div
        style={{
          position: 'absolute',
          left: 66,
          right: 66,
          top: 650,
          display: 'grid',
          gridTemplateColumns: '1fr 1fr',
          gap: 46,
        }}
      >
        <MiniModule frame={frame} index={0} label="REPORT" value="Dite como pensa." detail="O laudo se monta no template da casa." />
        <MiniModule frame={frame} index={1} label="GUIDE" value="Critério à vista." detail="Classificação sugerida para sua revisão." />
